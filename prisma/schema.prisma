generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  STAFF
}

enum GuestCategory {
  VIP
  FAMILY
  GENERAL
}

enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum FollowUpStatus {
  NONE
  NEEDS_FOLLOW_UP
  CALLBACK_LATER
  NO_ANSWER
  VOICEMAIL
  COMPLETED
}

enum CheckinMethod {
  QR
  MANUAL
}

enum CallStatus {
  QUEUED
  DIALING
  RINGING
  ANSWERED
  AI_ACTIVE
  COMPLETED
  FAILED
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  email     String    @unique
  role      UserRole  @default(STAFF)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  events    Event[]

  @@map("users")
}

model OtpToken {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at")
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@map("otp_tokens")
}

model Event {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  date      DateTime
  location  String
  createdBy String    @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  creator User          @relation(fields: [createdBy], references: [id])
  guests  Guest[]
  cabs    Cab[]
  hotels  Hotel[]
  setting EventSetting?
  calls   Call[]

  @@index([createdBy])
  @@map("events")
}

model EventSetting {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @unique @map("event_id") @db.Uuid
  ivrEnabled Boolean  @default(true) @map("ivr_enabled")
  qrEnabled  Boolean  @default(true) @map("qr_enabled")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_settings")
}

model Guest {
  id             String        @id @default(uuid()) @db.Uuid
  eventId        String        @map("event_id") @db.Uuid
  name           String
  phone          String
  email          String?
  pickupLocation String?       @map("pickup_location")
  pickupLat      Float?        @map("pickup_lat")
  pickupLng      Float?        @map("pickup_lng")
  category       GuestCategory @default(GENERAL)
  rsvpStatus     RsvpStatus    @default(PENDING) @map("rsvp_status")
  groupSize      Int           @default(1) @map("group_size")
  qrCode         String        @unique @map("qr_code")
  ivrRespondedAt DateTime?     @map("ivr_responded_at")
  followUpStatus FollowUpStatus @default(NONE) @map("follow_up_status")
  callbackAt     DateTime?     @map("callback_at")
  lastContactedAt DateTime?    @map("last_contacted_at")
  assignedTo     String?       @map("assigned_to")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ivrLogs         IvrLog[]
  calls           Call[]
  cabAssignments  CabAssignment[]
  roomAssignments RoomAssignment[]
  checkins        Checkin[]
  invites         GuestInvite[]

  @@unique([eventId, phone])
  @@index([eventId])
  @@index([eventId, rsvpStatus])
  @@map("guests")
}

model IvrLog {
  id                String   @id @default(uuid()) @db.Uuid
  eventId           String   @map("event_id") @db.Uuid
  guestId           String   @map("guest_id") @db.Uuid
  callStatus        String   @map("call_status")
  attempt           Int      @default(1)
  callDuration      Int?     @map("call_duration")
  responseInput     String?  @map("response_input")
  rsvpCaptured      Boolean  @default(false) @map("rsvp_captured")
  groupSizeCaptured Boolean  @default(false) @map("group_size_captured")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([guestId])
  @@map("ivr_logs")
}

model Call {
  id          String     @id @default(uuid()) @db.Uuid
  eventId     String     @map("event_id") @db.Uuid
  guestId     String     @map("guest_id") @db.Uuid
  phone       String
  status      CallStatus @default(QUEUED)
  callUuid    String?    @unique @map("call_uuid")
  provider    String     @default("plivo")
  lastEventAt DateTime?  @map("last_event_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  event  Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest  Guest       @relation(fields: [guestId], references: [id], onDelete: Cascade)
  events CallEvent[]

  @@index([eventId])
  @@index([guestId])
  @@index([status])
  @@map("calls")
}

model CallEvent {
  id             String   @id @default(uuid()) @db.Uuid
  callId         String?  @map("call_id") @db.Uuid
  callUuid       String   @map("call_uuid")
  provider       String   @default("plivo")
  type           String
  idempotencyKey String   @unique @map("idempotency_key")
  payload        Json
  createdAt      DateTime @default(now()) @map("created_at")

  call Call? @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@index([callUuid])
  @@index([type])
  @@map("call_events")
}

model Cab {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  driverName    String    @map("driver_name")
  driverPhone   String?   @map("driver_phone")
  vehicleNumber String    @map("vehicle_number")
  capacity      Int
  usedSeats     Int       @default(0) @map("used_seats")
  pickupTime    DateTime? @map("pickup_time")
  routeZone     String?   @map("route_zone")
  tripStatus    String?   @map("trip_status")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  event       Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments CabAssignment[]

  @@index([eventId])
  @@map("cabs")
}

model CabAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  cabId      String   @map("cab_id") @db.Uuid
  guestId    String   @map("guest_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  cab   Cab   @relation(fields: [cabId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([cabId, guestId])
  @@index([eventId])
  @@map("cab_assignments")
}

model Hotel {
  id        String    @id @default(uuid()) @db.Uuid
  eventId   String    @map("event_id") @db.Uuid
  name      String
  location  String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rooms Room[]

  @@index([eventId])
  @@map("hotels")
}

model Room {
  id         String    @id @default(uuid()) @db.Uuid
  hotelId    String    @map("hotel_id") @db.Uuid
  roomNumber String    @map("room_number")
  capacity   Int
  roomType   String?   @map("room_type")
  floor      String?
  roomStatus String?   @map("room_status")
  checkInDate DateTime? @map("check_in_date")
  checkOutDate DateTime? @map("check_out_date")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  hotel       Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  assignments RoomAssignment[]

  @@unique([hotelId, roomNumber])
  @@map("rooms")
}

model GuestInvite {
  id         String    @id @default(uuid()) @db.Uuid
  guestId    String    @map("guest_id") @db.Uuid
  code       String    @unique
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@index([code, revokedAt, expiresAt])
  @@map("guest_invites")
}

model RoomAssignment {
  id              String   @id @default(uuid()) @db.Uuid
  eventId         String   @map("event_id") @db.Uuid
  roomId          String   @map("room_id") @db.Uuid
  guestId         String   @map("guest_id") @db.Uuid
  assignedMembers Int      @map("assigned_members")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  room  Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([roomId, guestId])
  @@index([eventId])
  @@map("room_assignments")
}

model Checkin {
  id           String        @id @default(uuid()) @db.Uuid
  eventId      String        @map("event_id") @db.Uuid
  guestId      String        @map("guest_id") @db.Uuid
  checkinTime  DateTime      @default(now()) @map("checkin_time")
  method       CheckinMethod
  locationType String        @default("EVENT_GATE") @map("location_type")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([guestId])
  @@index([eventId])
  @@map("checkins")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
}

enum GuestCategory {
  VIP
  FAMILY
  GENERAL
}

enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum CheckinMethod {
  QR
  MANUAL
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  role      UserRole @default(STAFF)
  createdAt DateTime @default(now()) @map("created_at")

  events Event[]

  @@map("users")
}

model OtpToken {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at")
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("otp_tokens")
}

model Event {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  date      DateTime
  location  String
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  creator User    @relation(fields: [createdBy], references: [id])
  guests  Guest[]
  cabs    Cab[]
  hotels  Hotel[]

  @@index([createdBy])
  @@map("events")
}

model Guest {
  id          String        @id @default(uuid()) @db.Uuid
  eventId     String        @map("event_id") @db.Uuid
  name        String
  phone       String
  email       String?
  category    GuestCategory @default(GENERAL)
  rsvpStatus  RsvpStatus    @default(PENDING) @map("rsvp_status")
  groupSize   Int           @default(1) @map("group_size")
  qrCode      String        @unique @map("qr_code")
  createdAt   DateTime      @default(now()) @map("created_at")

  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ivrLogs        IvrLog[]
  cabAssignments CabAssignment[]
  roomAssignments RoomAssignment[]
  checkins       Checkin[]

  @@index([eventId])
  @@index([eventId, rsvpStatus])
  @@map("guests")
}

model IvrLog {
  id            String   @id @default(uuid()) @db.Uuid
  eventId       String   @map("event_id") @db.Uuid
  guestId       String   @map("guest_id") @db.Uuid
  callStatus    String   @map("call_status")
  responseInput String?  @map("response_input")
  createdAt     DateTime @default(now()) @map("created_at")

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([guestId])
  @@map("ivr_logs")
}

model Cab {
  id            String @id @default(uuid()) @db.Uuid
  eventId       String @map("event_id") @db.Uuid
  driverName    String @map("driver_name")
  vehicleNumber String @map("vehicle_number")
  capacity      Int

  event       Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments CabAssignment[]

  @@index([eventId])
  @@map("cabs")
}

model CabAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  cabId      String   @map("cab_id") @db.Uuid
  guestId    String   @map("guest_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  cab   Cab   @relation(fields: [cabId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([cabId, guestId])
  @@index([eventId])
  @@map("cab_assignments")
}

model Hotel {
  id       String @id @default(uuid()) @db.Uuid
  eventId  String @map("event_id") @db.Uuid
  name     String
  location String

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rooms Room[]

  @@index([eventId])
  @@map("hotels")
}

model Room {
  id         String @id @default(uuid()) @db.Uuid
  eventId    String @map("event_id") @db.Uuid
  hotelId    String @map("hotel_id") @db.Uuid
  roomNumber String @map("room_number")
  capacity   Int

  hotel       Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  assignments RoomAssignment[]

  @@unique([hotelId, roomNumber])
  @@index([eventId])
  @@map("rooms")
}

model RoomAssignment {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  roomId  String @map("room_id") @db.Uuid
  guestId String @map("guest_id") @db.Uuid

  room  Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([roomId, guestId])
  @@index([eventId])
  @@map("room_assignments")
}

model Checkin {
  id          String        @id @default(uuid()) @db.Uuid
  eventId     String        @map("event_id") @db.Uuid
  guestId     String        @map("guest_id") @db.Uuid
  checkinTime DateTime      @default(now()) @map("checkin_time")
  method      CheckinMethod

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([guestId])
  @@index([eventId])
  @@map("checkins")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String?  @map("event_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([eventId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

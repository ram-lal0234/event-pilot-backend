NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/event_pilot?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/event_pilot?schema=public
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM="Event Pilot <otp@yourdomain.com>"
QUEUE_PROVIDER=local
REALTIME_PROVIDER=local
REALTIME_WS_PORT=4001
AWS_REGION=ap-south-1
CALL_QUEUE_URL=
EVENT_QUEUE_URL=
AUDIT_QUEUE_URL=
AUDIT_LOG_TABLE_NAME=
PUBLIC_API_URL=
# Required in production — used for WhatsApp outreach, emails, and API-built RSVP/join links.
PUBLIC_RSVP_BASE_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=
PLIVO_ANSWER_URL=
# IVR XML (sync). Default: {PUBLIC_API_URL}/webhook/plivo/ivr/answer
PLIVO_IVR_ANSWER_URL=
# Plivo Vibe Agent Flow invoke URL (POST JSON), e.g. https://agentflow.plivo.com/v1/account/{auth_id}/flow/{flow_id}
PLIVO_AI_ANSWER_URL=
# Call API ring/hangup ingress. Default: {PUBLIC_API_URL}/webhook/plivo
PLIVO_WEBHOOK_URL=
# Plivo Vibe — configure all four (plus X-EventPilot-Voice-Secret if VOICE_AI_WEBHOOK_SECRET is set):
#   {PUBLIC_API_URL}/webhook/plivo/ai/hangup     — call ended (lifecycle)
#   {PUBLIC_API_URL}/webhook/plivo/ai/rsvp       — RSVP + no-answer (business result)
#   {PUBLIC_API_URL}/webhook/plivo/ai/transcript — recording + transcription
#   {PUBLIC_API_URL}/webhook/plivo/ai/error      — agent/platform errors
VOICE_DEFAULT_CALL_MODE=ai
VOICE_AI_WEBHOOK_SECRET=
VOICE_TRANSPORT_ENABLED=true
VOICE_HOTEL_ENABLED=true
# Server-side WhatsApp sender (whatsapp-mcp bridge). Same contract as frontend bridge.
WHATSAPP_SENDER_URL=https://wa.eventpilotai.site/api/send
# Hard cap per send to protect the linked WhatsApp number (milliseconds).
WHATSAPP_SEND_TIMEOUT_MS=5000
# Required when QUEUE_PROVIDER=sqs (leave empty for local dev).
NOTIFICATION_QUEUE_URL=
